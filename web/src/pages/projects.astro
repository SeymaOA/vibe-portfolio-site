---
import ProjectCard from '@/components/ProjectCard.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const projects = [
  {
    title: 'PetCare App',
    description:
      'A desktop pet care management app built with Java Swing and an Apache Derby database. The app stores pet and owner details, connects to a local database, and supports manually adding and viewing animal records.',
    status: 'Shipped',
    tools: ['Java Swing', 'Apache Derby', 'SQL', 'Eclipse'],
    images: [
      {
        src: '/petcare-login.png',
        alt: 'PetCare App login screen with username and password fields',
      },
      {
        src: '/petcare-dashboard.png',
        alt: 'PetCare App main screen with pet list, selected pet details, and notes',
      },
    ],
    href: '#',
  },
  {
    title: 'NASA Mission Dashboard',
    description:
      'A Java Swing desktop dashboard that loads NASA Astronomy Picture of the Day data from the NASA API, displays the image and explanation, saves favorites to a text file, and includes a moon travel time calculator.',
    status: 'Built',
    tools: ['Java Swing', 'NASA API', 'HTTP Client', 'Regex', 'File I/O'],
    href: '#',
  },
  {
    title: 'Project three',
    description:
      'Placeholder: link “Learn more” to a case study or repo when you add detail pages.',
    status: 'Experiment',
    tools: ['UI', 'Research'],
    href: '#',
  },
];
---

<BaseLayout title="Projects" description="Selected work and experiments.">
  <SiteHeader />
  <main class="page-main">
    <div class="wrap stack-lg" style="padding-block: var(--space-3xl)">
      <h1>Projects</h1>
      <p class="prose" style="max-width: var(--content-narrow)">
        Selected projects from my work in software engineering, education, and science.
      </p>
      <div class="project-grid">
        {projects.map((p) => (
          <ProjectCard {...p} />
        ))}
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
