# Copy to `.env` for local dev. On Cloudflare Pages, add the same vars in
# Project → Settings → Environment variables (mark non-secret ones as plain text).

# HTTPS URL of your signup API (e.g. Cloudflare Worker, MailerLite form endpoint).
PUBLIC_NEWSLETTER_ENDPOINT=

# Optional: list or audience ID if your endpoint expects it (matches Code Playbook worker-style JSON).
PUBLIC_NEWSLETTER_LIST_ID=
